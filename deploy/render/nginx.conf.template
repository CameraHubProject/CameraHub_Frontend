server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;
    client_max_body_size 6m;
    resolver ${DNS_RESOLVER} valid=30s ipv6=off;

    location = /healthz {
        access_log off;
        default_type application/json;
        return 200 '{"status":"UP"}';
    }

    # One public origin for cookies, CSRF, Google callbacks, and media URLs.
    location ^~ /api/ {
        set $gateway http://${GATEWAY_HOSTPORT};
        proxy_pass $gateway$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_connect_timeout 10s;
        proxy_read_timeout 100s;
        proxy_send_timeout 100s;
        proxy_intercept_errors off;
        error_page 502 503 504 =503 @api_unavailable;
    }

    location @api_unavailable {
        default_type application/json;
        add_header Cache-Control no-store always;
        return 503 '{"code":503,"errorCode":"SERVICE_UNAVAILABLE","message":"Dịch vụ tạm thời chưa sẵn sàng. Vui lòng thử lại sau.","data":null,"errors":{}}';
    }

    location ^~ /internal/ { return 404; }
    location ^~ /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
    location = /index.html { add_header Cache-Control no-cache; }
    location / { try_files $uri $uri/ /index.html; }
}
